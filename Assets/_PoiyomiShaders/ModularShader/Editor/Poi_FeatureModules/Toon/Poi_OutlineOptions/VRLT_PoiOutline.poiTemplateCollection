#T#PoiOutlineVariables
//ifex _EnableOutlines!=1
#ifdef POI_TRIPLE_OUTLINE
#define POI_OUTLINE_VALUE(name, layer) POI##name(layer)
#define POI_OUTLINE_MASK(mask, name, layer) (POI_OUTLINE_VALUE(name, layer) >= 4 ? 1.0 : (mask)[(uint)clamp(POI_OUTLINE_VALUE(name, layer), 0, 3)])
#else
#define POI_OUTLINE_VALUE(name, layer) name
#define POI_OUTLINE_MASK(mask, name, layer) 1.0
#endif

#ifdef POI_PASS_OUTLINE
	#if defined(PROP_OUTLINETEXTURE) || !defined(OPTIMIZER_ENABLED)
		Texture2D _OutlineTexture;
	#endif
	#if defined(PROP_OUTLINEMASK) || !defined(OPTIMIZER_ENABLED)
		Texture2D _OutlineMask;
	#endif
	#ifdef POI_TRIPLE_OUTLINE
		#if defined(PROP_OUTLINE2TEXTURE) || !defined(OPTIMIZER_ENABLED)
			Texture2D _Outline2Texture;
		#endif
		#if defined(PROP_OUTLINE3TEXTURE) || !defined(OPTIMIZER_ENABLED)
			Texture2D _Outline3Texture;
		#endif
	#endif
#endif
//endex

#T#OutlineVertexOffset
//ifex _EnableOutlines!=1
#ifdef POI_PASS_OUTLINE
	#if defined(PROP_OUTLINEMASK) || !defined(OPTIMIZER_ENABLED)
		half4 outlineMaskTex = UNITY_SAMPLE_TEX2D_SAMPLER_LOD(_OutlineMask, _linear_repeat, poiUV(vertexUV(v, _OutlineMaskUV), _OutlineMask_ST) + POI_TIME.x * _OutlineMaskPan, 0);
		half outlineMask = POI_OUTLINE_VALUE(_OutlineMaskChannel, poiOutlineLayer) >= 4 ? 1 : outlineMaskTex[(uint)clamp(POI_OUTLINE_VALUE(_OutlineMaskChannel, poiOutlineLayer), 0, 3)];
		float outLineZOffset = abs(lerp(1, outlineMaskTex[POI_OUTLINE_VALUE(_OutlineZOffsetChannel, poiOutlineLayer)], POI_OUTLINE_VALUE(_OutlineZOffsetMaskStrength, poiOutlineLayer)) - POI_OUTLINE_VALUE(_OutlineZOffsetInvertMaskChannel, poiOutlineLayer));
	#else
		half4 outlineMaskTex = 1;
		half outlineMask = 1;
		float outLineZOffset = 1;
	#endif
	if (POI_OUTLINE_VALUE(_OutlineVertexColorMask, poiOutlineLayer) > 0)
	{
		outlineMask *= lerp(1, v.color[POI_OUTLINE_VALUE(_OutlineVertexColorMask, poiOutlineLayer) - 1], POI_OUTLINE_VALUE(_OutlineVertexColorMaskStrength, poiOutlineLayer) * POI_OUTLINE_MASK(outlineMaskTex, _OutlineVertexColorMaskChannel, poiOutlineLayer));
	}
	if (POI_OUTLINE_VALUE(_OutlineZOffsetVertexColor, poiOutlineLayer))
	{
		outLineZOffset *= lerp(1, v.color[POI_OUTLINE_VALUE(_OutlineZOffsetVertexColor, poiOutlineLayer) - 1], POI_OUTLINE_VALUE(_OutlineZOffsetVertexColorStrength, poiOutlineLayer));
	}

	float3 outlineNormal = POI_OUTLINE_VALUE(_OutlineSpace, poiOutlineLayer) ? o.normal.xyz : v.normal;
	//UNITY_BRANCH
	if (POI_OUTLINE_VALUE(_OutlineUseVertexColorNormals, poiOutlineLayer) >= 0.5)
	{
		float3 outlineTangent;
		float3 outlineBinormal;
		if (POI_OUTLINE_VALUE(_OutlineSpace, poiOutlineLayer)) // 0 Local, 1 World

		{
			outlineTangent = o.tangent.xyz;
			outlineBinormal = cross(o.normal.xyz, o.tangent.xyz) * (v.tangent.w * unity_WorldTransformParams.w);
		}
		else
		{
			outlineTangent = v.tangent.xyz;
			outlineBinormal = normalize(cross(outlineNormal, outlineTangent)) * (v.tangent.w * length(outlineNormal));
		}
		float3 outlineVectorTS = v.color.rgb * 2.0 - 1.0;
		outlineNormal = outlineVectorTS.x * outlineTangent + outlineVectorTS.y * outlineBinormal + outlineVectorTS.z * outlineNormal;
	}

	float offsetMultiplier = 1;
	float distanceOffset = 1;
	//UNITY_BRANCH
	if (POI_OUTLINE_VALUE(_OutlineFixedSize, poiOutlineLayer) >= 0.5)
	{
		distanceOffset *= lerp(1.0, clamp((distance(getCameraPosition(), mul(unity_ObjectToWorld, o.localPos).xyz)) / o.normal.w, 0.0f, POI_OUTLINE_VALUE(_OutlinesMaxDistance, poiOutlineLayer)), POI_OUTLINE_VALUE(_OutlineFixWidth, poiOutlineLayer) * POI_OUTLINE_MASK(outlineMaskTex, _OutlineFixedSizeMaskChannel, poiOutlineLayer));
	}

	float lineWidth = POI_OUTLINE_VALUE(_LineWidth, poiOutlineLayer);
	

	#ifdef POI_AUDIOLINK
		// Due to PoiMods.audioLink being frag only I'll just
		// recreate what it does here for this vertex function
		//UNITY_BRANCH
		if (_AudioLinkAnimToggle >= 0.5)
		{
			if (AudioLinkIsAvailable())
			{
				lineWidth += lerp(POI_OUTLINE_VALUE(_AudioLinkOutlineSize, poiOutlineLayer).x, POI_OUTLINE_VALUE(_AudioLinkOutlineSize, poiOutlineLayer).y, AudioLinkData(uint2(0, POI_OUTLINE_VALUE(_AudioLinkOutlineSizeBand, poiOutlineLayer)))) * POI_OUTLINE_MASK(outlineMaskTex, _OutlineAudioLinkMaskChannel, poiOutlineLayer);
			}
		}
	#endif
	
	float3 offset = outlineNormal * (lineWidth * _EnableOutlines / 100) * outlineMask * distanceOffset;
	
	//UNITY_BRANCH
	if (POI_OUTLINE_VALUE(_OutlineExpansionMode, poiOutlineLayer) == 2)
	{
		#if POI_PIPE == POI_BIRP
			float3 lightDirection = normalize(_WorldSpaceLightPos0 + PoiSHAr.xyz + PoiSHAg.xyz + PoiSHAb.xyz);
		#elif POI_PIPE == POI_URP
			Light mainLight = GetMainLight();
			float3 lightDirection = normalize(mainLight.direction + PoiSHAr.xyz + PoiSHAg.xyz + PoiSHAb.xyz);
		#endif
		offsetMultiplier = saturate(dot(lightDirection, outlineNormal));
		offset *= offsetMultiplier;
		offset *= distanceOffset;
	}
	else if (POI_OUTLINE_VALUE(_OutlineExpansionMode, poiOutlineLayer) == 3)
	{
		float3 viewNormal = mul((float3x3)UNITY_MATRIX_V, outlineNormal);
		offsetMultiplier = saturate(dot(viewNormal.xy, normalize(POI_OUTLINE_VALUE(_OutlinePersonaDirection, poiOutlineLayer).xy)));
		
		offset *= offsetMultiplier;
		offset *= distanceOffset;
	}
	else if (POI_OUTLINE_VALUE(_OutlineExpansionMode, poiOutlineLayer) == 4)
	{
		offset = mul((float3x3)transpose(UNITY_MATRIX_V), POI_OUTLINE_VALUE(_OutlineDropShadowOffset, poiOutlineLayer).xyz);
		#ifdef POI_TRIPLE_OUTLINE
			offset *= outlineMask;
		#endif
		offset *= distanceOffset;
	}
	if (POI_OUTLINE_VALUE(_OutlineSpace, poiOutlineLayer) == 0)
	{
		localOffset += offset;
		worldOffset += mul((float3x3)unity_ObjectToWorld, offset);
	}
	else
	{
		offset *= o.normal.w;
		localOffset += mul((float3x3)unity_WorldToObject, offset);
		worldOffset += offset;
	}
#endif
//endex

#T#OutLineZOffset
//ifex _EnableOutlines!=1
#ifdef POI_PASS_OUTLINE
	#if defined(UNITY_REVERSED_Z)
		//DX
		o.pos.z += POI_OUTLINE_VALUE(_Offset_Z, poiOutlineLayer) * outLineZOffset * - 0.0001;
	#else
		//OpenGL
		o.pos.z += POI_OUTLINE_VALUE(_Offset_Z, poiOutlineLayer) * outLineZOffset * 0.0001;
	#endif
#endif
//endex

#T#OutlineFragmentFunction
//ifex _EnableOutlines!=1
#ifdef POI_PASS_OUTLINE
	// Shared by the outline body and the highlight so both stay in step under Color Adjust
	half3 poiOutlineColorAdjust(half3 color, uint poiOutlineLayer)
	{
		float hue = frac(POI_OUTLINE_VALUE(_OutlineHue, poiOutlineLayer) + POI_OUTLINE_VALUE(_OutlineHueOffsetSpeed, poiOutlineLayer) * POI_TIME.x);
		color = hueShift(color, hue, POI_OUTLINE_VALUE(_OutlineHueShiftColorSpace, poiOutlineLayer), 1.0);
		[flatten]
		switch ((int)POI_OUTLINE_VALUE(_OutlineSaturationMethod, poiOutlineLayer))
		{
			// Saturation/Value (old)
			case 0:
			{
				color = ModifyViaHSV(color, 0.0, POI_OUTLINE_VALUE(_OutlineSaturation, poiOutlineLayer), POI_OUTLINE_VALUE(_OutlineValue, poiOutlineLayer));
				break;
			}
			// Saturation/Brightness (new)
			case 1:
			{
				color = lerp(color, dot(color, float3(0.3, 0.59, 0.11)), -POI_OUTLINE_VALUE(_OutlineSaturation, poiOutlineLayer));
				color = saturate(color * (POI_OUTLINE_VALUE(_OutlineBrightness, poiOutlineLayer) + 1));
				break;
			}
		}
		return pow(abs(color), POI_OUTLINE_VALUE(_OutlineGamma, poiOutlineLayer));
	}

	void applyOutlineColor(inout PoiFragData poiFragData, in PoiMesh poiMesh, inout PoiLight poiLight, in PoiMods poiMods, in PoiCam poiCam)
	{
		clip(_EnableOutlines - 0.01);
		#if defined(PROP_OUTLINEMASK) || !defined(OPTIMIZER_ENABLED)
			// One mask sample shared by every layer; only the channel picks differ per layer
			half4 outlineMaskTex = UNITY_SAMPLE_TEX2D_SAMPLER(_OutlineMask, _linear_repeat, poiUV(poiMesh.uv[_OutlineMaskUV], _OutlineMask_ST) + POI_TIME.x * _OutlineMaskPan);
			half OutlineMask = POI_OUTLINE_VALUE(_OutlineMaskChannel, poiMesh.outlineLayer) >= 4 ? 1 : outlineMaskTex[(uint)clamp(POI_OUTLINE_VALUE(_OutlineMaskChannel, poiMesh.outlineLayer), 0, 3)];
		#else
			half4 outlineMaskTex = 1;
			half OutlineMask = 1;
		#endif
		if (POI_OUTLINE_VALUE(_OutlineVertexColorMask, poiMesh.outlineLayer) > 0)
		{
			OutlineMask *= lerp(1, poiMesh.vertexColor[POI_OUTLINE_VALUE(_OutlineVertexColorMask, poiMesh.outlineLayer) - 1], POI_OUTLINE_VALUE(_OutlineVertexColorMaskStrength, poiMesh.outlineLayer) * POI_OUTLINE_MASK(outlineMaskTex, _OutlineVertexColorMaskChannel, poiMesh.outlineLayer));
		}

		#ifdef POI_TRIPLE_OUTLINE
			poiLight.finalLighting = lerp(1, poiLight.finalLighting, POI_OUTLINE_MASK(outlineMaskTex, _OutlineLightingMaskChannel, poiMesh.outlineLayer));
		#endif

		if (POI_OUTLINE_VALUE(_OutlineClipAtZeroWidth, poiMesh.outlineLayer) >= 0.5)
		{
			float lineWidth = POI_OUTLINE_VALUE(_LineWidth, poiMesh.outlineLayer);

			#ifdef POI_AUDIOLINK
				//UNITY_BRANCH
				if (poiMods.audioLinkAvailable)
				{
					lineWidth += lerp(POI_OUTLINE_VALUE(_AudioLinkOutlineSize, poiMesh.outlineLayer).x, POI_OUTLINE_VALUE(_AudioLinkOutlineSize, poiMesh.outlineLayer).y, poiMods.audioLink[POI_OUTLINE_VALUE(_AudioLinkOutlineSizeBand, poiMesh.outlineLayer)]) * POI_OUTLINE_MASK(outlineMaskTex, _OutlineAudioLinkMaskChannel, poiMesh.outlineLayer);
				}
			#endif
			clip(OutlineMask * lineWidth - 0.001);
		}
		#if defined(PROP_OUTLINETEXTURE) || !defined(OPTIMIZER_ENABLED)
			float4 col = POI2D_SAMPLER_PAN(_OutlineTexture, _MainTex, poiUV(poiMesh.uv[POI_OUTLINE_VALUE(_OutlineTextureUV, poiMesh.outlineLayer)], POI_OUTLINE_VALUE(_OutlineTexture_ST, poiMesh.outlineLayer)), POI_OUTLINE_VALUE(_OutlineTexturePan, poiMesh.outlineLayer));
		#else
			float4 col = float4(1, 1, 1, 1);
		#endif
		#ifdef POI_TRIPLE_OUTLINE
			#if defined(PROP_OUTLINE2TEXTURE) || !defined(OPTIMIZER_ENABLED)
				if (poiMesh.outlineLayer == 1) col = POI2D_SAMPLER_PAN(_Outline2Texture, _MainTex, poiUV(poiMesh.uv[POI_OUTLINE_VALUE(_OutlineTextureUV, poiMesh.outlineLayer)], POI_OUTLINE_VALUE(_OutlineTexture_ST, poiMesh.outlineLayer)), POI_OUTLINE_VALUE(_OutlineTexturePan, poiMesh.outlineLayer));
			#else
				if (poiMesh.outlineLayer == 1) col = float4(1, 1, 1, 1);
			#endif
			#if defined(PROP_OUTLINE3TEXTURE) || !defined(OPTIMIZER_ENABLED)
				else if (poiMesh.outlineLayer == 2) col = POI2D_SAMPLER_PAN(_Outline3Texture, _MainTex, poiUV(poiMesh.uv[POI_OUTLINE_VALUE(_OutlineTextureUV, poiMesh.outlineLayer)], POI_OUTLINE_VALUE(_OutlineTexture_ST, poiMesh.outlineLayer)), POI_OUTLINE_VALUE(_OutlineTexturePan, poiMesh.outlineLayer));
			#else
				else if (poiMesh.outlineLayer == 2) col = float4(1, 1, 1, 1);
			#endif
		#endif

		poiFragData.baseColor = lerp(col.rgb, col.rgb * poiFragData.baseColor * lerp(1, poiFragData.baseColor, POI_OUTLINE_VALUE(_PoiUTSStyleOutlineBlend, poiMesh.outlineLayer)), POI_OUTLINE_VALUE(_OutlineTintMix, poiMesh.outlineLayer) * POI_OUTLINE_MASK(outlineMaskTex, _OutlineTextureBlendMaskChannel, poiMesh.outlineLayer));
		half4 outlineColor = POI_OUTLINE_VALUE(_LineColor, poiMesh.outlineLayer);

		#ifdef POI_AUDIOLINK
			if (POI_OUTLINE_VALUE(_OutlineALColorEnabled, poiMesh.outlineLayer) >= 0.5 && poiMods.audioLinkAvailable)
			{
				half alColorOverrideIntensity = poiMods.audioLink[POI_OUTLINE_VALUE(_AudioLinkOutlineColorBand, poiMesh.outlineLayer)] * POI_OUTLINE_MASK(outlineMaskTex, _OutlineAudioLinkMaskChannel, poiMesh.outlineLayer);
				half alColorOverrideBlend = evalRamp4(alColorOverrideIntensity, POI_OUTLINE_VALUE(_AudioLinkOutlineColorRamp, poiMesh.outlineLayer));
				if(alColorOverrideBlend > 0)
				{
					half3 alOverrideColor = POI_OUTLINE_VALUE(_AudioLinkOutlineColor, poiMesh.outlineLayer).rgb;
					if(POI_OUTLINE_VALUE(_AudioLinkOutlineColorThemeIndex, poiMesh.outlineLayer) > 0)
					{
						alOverrideColor = poiThemeColor(poiMods, alOverrideColor, POI_OUTLINE_VALUE(_AudioLinkOutlineColorThemeIndex, poiMesh.outlineLayer));
					}
					outlineColor.rgb = lerp(outlineColor.rgb, alOverrideColor, alColorOverrideBlend);
				}
			}
		#endif

		// Untinted outline color, used as the optional tint source for the highlight below
    	half3 outlineHighlightTint = poiFragData.baseColor;

		poiFragData.baseColor *= lerp(half3(1,1,1), poiThemeColor(poiMods, outlineColor.rgb, POI_OUTLINE_VALUE(_LineColorThemeIndex, poiMesh.outlineLayer)), POI_OUTLINE_MASK(outlineMaskTex, _OutlineColorMaskChannel, poiMesh.outlineLayer));
		col.a *= outlineColor.a * POI_OUTLINE_MASK(outlineMaskTex, _OutlineAlphaMaskChannel, poiMesh.outlineLayer);
		if (POI_OUTLINE_VALUE(_OutlineHueShift, poiMesh.outlineLayer) >= 0.5)
		{
			poiFragData.baseColor.rgb = lerp(poiFragData.baseColor.rgb, poiOutlineColorAdjust(poiFragData.baseColor.rgb, poiMesh.outlineLayer), POI_OUTLINE_MASK(outlineMaskTex, _OutlineColorAdjustMaskChannel, poiMesh.outlineLayer));
		}
		
		if (POI_OUTLINE_VALUE(_OutlineExpansionMode, poiMesh.outlineLayer) == 2)
		{
			poiFragData.baseColor = lerp(poiFragData.baseColor, poiLight.directColor, POI_OUTLINE_VALUE(_OutlineRimLightBlend, poiMesh.outlineLayer));
		}

		half outlineHighlight = 0;
		if (POI_OUTLINE_VALUE(_OutlineHighlightEnabled, poiMesh.outlineLayer) >= 0.5)
		{
			// Screen space N dot L: the outline is a hull with no visible shading of its own,
			// so the highlight is driven by where the light sits around the silhouette.
			float3 viewNormal = mul((float3x3)UNITY_MATRIX_V, poiMesh.normals[0]);
			float3 viewLight = mul((float3x3)UNITY_MATRIX_V, poiLight.direction);
			float2 highlightN = length(viewNormal.xy) > 1e-6 ? normalize(viewNormal.xy) : float2(0, 1);
			float2 highlightL = length(viewLight.xy) > 1e-6 ? normalize(viewLight.xy) : float2(0, 1);
			half highlightNDotL = dot(highlightN, highlightL) * 0.5 + 0.5;
			outlineHighlight = poiEdgeLinear(highlightNDotL, POI_OUTLINE_VALUE(_OutlineHighlightBorder, poiMesh.outlineLayer), POI_OUTLINE_VALUE(_OutlineHighlightBlur, poiMesh.outlineLayer)) * POI_OUTLINE_VALUE(_OutlineHighlightColor, poiMesh.outlineLayer).a;
			if (POI_OUTLINE_VALUE(_OutlineHighlightReceiveShadow, poiMesh.outlineLayer) >= 0.5)
			{
				outlineHighlight *= poiLight.attenShadowsStrength;
			}
			half3 highlightColor = POI_OUTLINE_VALUE(_OutlineHighlightColor, poiMesh.outlineLayer).rgb;
			#ifdef POI_AUDIOLINK
				if (POI_OUTLINE_VALUE(_OutlineHighlightALColorEnabled, poiMesh.outlineLayer) >= 0.5 && poiMods.audioLinkAvailable)
				{
					half alHighlightOverrideIntensity = poiMods.audioLink[POI_OUTLINE_VALUE(_AudioLinkOutlineHighlightColorBand, poiMesh.outlineLayer)] * POI_OUTLINE_MASK(outlineMaskTex, _OutlineAudioLinkMaskChannel, poiMesh.outlineLayer);
					half alHighlightOverrideBlend = evalRamp4(alHighlightOverrideIntensity, POI_OUTLINE_VALUE(_AudioLinkOutlineHighlightColorRamp, poiMesh.outlineLayer));
					if (alHighlightOverrideBlend > 0)
					{
						half3 alHighlightOverrideColor = POI_OUTLINE_VALUE(_AudioLinkOutlineHighlightColor, poiMesh.outlineLayer).rgb;
						if (POI_OUTLINE_VALUE(_AudioLinkOutlineHighlightColorThemeIndex, poiMesh.outlineLayer) > 0)
						{
							alHighlightOverrideColor = poiThemeColor(poiMods, alHighlightOverrideColor, POI_OUTLINE_VALUE(_AudioLinkOutlineHighlightColorThemeIndex, poiMesh.outlineLayer));
						}
						highlightColor = lerp(highlightColor, alHighlightOverrideColor, alHighlightOverrideBlend);
					}
				}
			#endif
			highlightColor = poiThemeColor(poiMods, highlightColor, POI_OUTLINE_VALUE(_OutlineHighlightColorThemeIndex, poiMesh.outlineLayer));
			if (POI_OUTLINE_VALUE(_OutlineHighlightApplyTex, poiMesh.outlineLayer) >= 0.5)
			{
				highlightColor *= outlineHighlightTint;
			}
			// Applied here rather than earlier so the highlight sees the same tex * color input the body does
			if (POI_OUTLINE_VALUE(_OutlineHueShift, poiMesh.outlineLayer) >= 0.5)
			{
				highlightColor = lerp(highlightColor, poiOutlineColorAdjust(highlightColor, poiMesh.outlineLayer), POI_OUTLINE_MASK(outlineMaskTex, _OutlineColorAdjustMaskChannel, poiMesh.outlineLayer));
			}
			outlineHighlight *= POI_OUTLINE_MASK(outlineMaskTex, _OutlineHighlightMaskChannel, poiMesh.outlineLayer);
			poiFragData.baseColor = lerp(poiFragData.baseColor, highlightColor, outlineHighlight);
		}
		
		if (POI_OUTLINE_VALUE(_OutlineOverrideAlpha, poiMesh.outlineLayer) >= 0.5)
		{
			poiFragData.alpha = col.a;
		}
		else
		{
			poiFragData.alpha *= col.a;
		}
		
		float outlineEdgeFade = POI_OUTLINE_VALUE(_OutlineEdgeFade, poiMesh.outlineLayer);
		if (outlineEdgeFade > 0)
		{
		    float outlineFacing = abs(dot(normalize(poiMesh.normals[0]), poiCam.viewDir));
		    poiFragData.alpha *= smoothstep(0.0, max(outlineEdgeFade, 0.0001), outlineFacing);
		}
		
		if (POI_OUTLINE_VALUE(_OutlineAlphaDistanceFade, poiMesh.outlineLayer) >= 0.5)
		{
			float3 position = POI_OUTLINE_VALUE(_OutlineAlphaDistanceFadeType, poiMesh.outlineLayer) ? poiMesh.worldPos : poiMesh.objectPosition;
			poiFragData.alpha *= lerp(1, lerp(POI_OUTLINE_VALUE(_OutlineAlphaDistanceFadeMinAlpha, poiMesh.outlineLayer), POI_OUTLINE_VALUE(_OutlineAlphaDistanceFadeMaxAlpha, poiMesh.outlineLayer), smoothstep(POI_OUTLINE_VALUE(_OutlineAlphaDistanceFadeMin, poiMesh.outlineLayer), POI_OUTLINE_VALUE(_OutlineAlphaDistanceFadeMax, poiMesh.outlineLayer), distance(position, poiCam.worldPos))), POI_OUTLINE_MASK(outlineMaskTex, _OutlineDistanceFadeMaskChannel, poiMesh.outlineLayer));
		}
		
		half emission = POI_OUTLINE_VALUE(_OutlineEmission, poiMesh.outlineLayer);
		
		half highlightEmission = POI_OUTLINE_VALUE(_OutlineHighlightEmission, poiMesh.outlineLayer);

		#ifdef POI_AUDIOLINK
			//UNITY_BRANCH
			if (poiMods.audioLinkAvailable)
			{
				emission += lerp(POI_OUTLINE_VALUE(_AudioLinkOutlineEmission, poiMesh.outlineLayer).x, POI_OUTLINE_VALUE(_AudioLinkOutlineEmission, poiMesh.outlineLayer).y, poiMods.audioLink[POI_OUTLINE_VALUE(_AudioLinkOutlineEmissionBand, poiMesh.outlineLayer)]) * POI_OUTLINE_MASK(outlineMaskTex, _OutlineAudioLinkMaskChannel, poiMesh.outlineLayer);
				highlightEmission += lerp(POI_OUTLINE_VALUE(_AudioLinkOutlineHighlightEmission, poiMesh.outlineLayer).x, POI_OUTLINE_VALUE(_AudioLinkOutlineHighlightEmission, poiMesh.outlineLayer).y, poiMods.audioLink[POI_OUTLINE_VALUE(_AudioLinkOutlineHighlightEmissionBand, poiMesh.outlineLayer)]) * POI_OUTLINE_MASK(outlineMaskTex, _OutlineAudioLinkMaskChannel, poiMesh.outlineLayer);
			}
		#endif

		// Stacks on top of the outline emission so the highlight can glow on a non-emissive outline
    	emission *= POI_OUTLINE_MASK(outlineMaskTex, _OutlineEmissionMaskChannel, poiMesh.outlineLayer);
		emission += highlightEmission * outlineHighlight; 
		
		poiFragData.emission += poiFragData.baseColor * emission;
	}
#endif
//endex

#T#OutlineFragmentFunctionCall
//ifex _EnableOutlines!=1
#ifdef POI_PASS_OUTLINE
	applyOutlineColor(poiFragData, poiMesh, poiLight, poiMods, poiCam);
#endif
//endex

#T#OutlineForceSmoothNormals
//ifex _EnableOutlines!=1
#ifdef POI_PASS_OUTLINE
	poiMesh.normals[1] = poiMesh.normals[0];
#endif
//endex
