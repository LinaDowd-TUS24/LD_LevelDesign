		float _AudioLinkOutlineHighlightColorBand;
		half4 _AudioLinkOutlineHighlightColor;
		float _AudioLinkOutlineHighlightColorThemeIndex;
		half4 _AudioLinkOutlineHighlightColorRamp;
	#endif

	// Layer Rendering Options
	float _OutlineClipAtZeroWidth;
	half _OutlineOverrideAlpha;
	float _Offset_Z;
	#if defined(PROP_OUTLINEMASK) || !defined(OPTIMIZER_ENABLED)
		float _OutlineZOffsetChannel;
		half _OutlineZOffsetMaskStrength;
		float _OutlineZOffsetInvertMaskChannel;
	#endif
	float _OutlineZOffsetVertexColor;
	half _OutlineZOffsetVertexColorStrength;
#endif
