#T#PoiRaymarchingDataFunctions
// Baked mesh data shared by every raymarching module.
//
// A module opts in from its own keywords template, so a shader that has no raymarching feature
// enabled carries none of this — no interpolators, no texture, no code:
//
//     #ifdef MY_RAYMARCHING_KEYWORD
//         #define POI_RAYMARCHING_DATA
//     #endif
//
// and adds its enable property to the //ifex lines in this collection so the optimizer can strip
// the data out of locked materials that don't use it.
//ifex _InternalWaterEnable==0
#ifdef POI_RAYMARCHING_DATA

    static const int cSDFRaymarchMaxSteps = 64;

    // Distance from a point inside the mesh to where the ray leaves it, marched through the
    // baked SDF. Positions are object space, relative to the mesh origin the SDF was baked in.
    // Falls back to a sphere-ish guess when no SDF has been baked.
    float PoiGetModelThickness(float3 startPos, float3 marchDir)
    {
        float fallbackThickness = max(_MinThickness, -2.0 * dot(startPos, marchDir));
        #if defined(PROP_SDFTEXTURE) || !defined(OPTIMIZER_ENABLED)
        if (all(_SDFTexture_TexelSize == 1.0))
            return fallbackThickness;
        startPos -= _SDFLowerCorner.xyz;
        startPos /= _SDFSize.xyz;
        marchDir /= _SDFSize.xyz;
        float total = _SDFPixelSize;
        float minSDFStep = _SDFPixelSize * (1.0 / 3.0);
        [loop]
        for (int step = 0; step < cSDFRaymarchMaxSteps; step++)
        {
            float3 uvw = startPos + marchDir * total;
            float d = -_SDFTexture.SampleLevel(sampler_linear_clamp, uvw, 0.0).r;
            if (d < -_SDFPixelSize) return max(_MinThickness, total + d);
            total += max(d, minSDFStep);
        }
        return max(_MinThickness, total);
        #else
        return fallbackThickness;
        #endif
    }

    // Unbaked meshes hand the same value to all three slots, so any difference means real data.
    bool PoiIsBindDataSet(float4 bindPos, float4 bindNorm, float4 bindTan)
    {
        const float bindDataEpsilon = 0.0001;
        bool positionDiffersFromNormal = any(abs(bindPos - bindNorm) > bindDataEpsilon);
        bool positionDiffersFromTangent = any(abs(bindPos - bindTan) > bindDataEpsilon);
        bool normalDiffersFromTangent = any(abs(bindNorm - bindTan) > bindDataEpsilon);
        return positionDiffersFromNormal && positionDiffersFromTangent && normalDiffersFromTangent;
    }

    // Whether to raymarch in bind space rather than object space: forced on, or on when the
    // mesh actually carries baked bind data.
    bool PoiUseBindData(in PoiMesh poiMesh)
    {
        return (_BindDataMode == 1) ||
                (_BindDataMode == 3 && PoiIsBindDataSet(poiMesh.bindPosition, poiMesh.bindNormal, poiMesh.bindTangent));
    }

#endif
//endex

