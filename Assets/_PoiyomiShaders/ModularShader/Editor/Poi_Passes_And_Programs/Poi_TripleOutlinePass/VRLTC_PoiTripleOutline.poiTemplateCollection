// Relay SV_VertexID through a user semantic to preserve vertex-ID effects.
struct PoiTripleOutlineInput
{
    float4 vertex : SV_POSITION;
    float3 normal : NORMAL;
    float4 tangent : TANGENT;
    half4 color : COLOR;
    float2 uv0 : TEXCOORD0;
    float2 uv1 : TEXCOORD1;
    float2 uv2 : TEXCOORD2;
    float2 uv3 : TEXCOORD3;
    nointerpolation uint vertexId : TEXCOORD4;
    #ifdef POI_RAYMARCHING_DATA
    float4 poiBindPosition : TEXCOORD5;
    half4 poiBindNormal : TEXCOORD6;
    half4 poiBindTangent : TEXCOORD7;
    #endif
    UNITY_VERTEX_INPUT_INSTANCE_ID
};

PoiTripleOutlineInput poiTripleOutlineVert(appdata v)
{
    PoiTripleOutlineInput o;
    PoiInitStruct(PoiTripleOutlineInput, o);
    UNITY_SETUP_INSTANCE_ID(v);
    UNITY_TRANSFER_INSTANCE_ID(v, o);
    o.vertex = v.vertex;
    o.normal = v.normal;
    o.tangent = v.tangent;
    o.color = v.color;
    o.uv0 = v.uv0;
    o.uv1 = v.uv1;
    o.uv2 = v.uv2;
    o.uv3 = v.uv3;
    o.vertexId = v.vertexId;
    #ifdef POI_RAYMARCHING_DATA
    o.poiBindPosition = v.poiBindPosition;
    o.poiBindNormal = v.poiBindNormal;
    o.poiBindTangent = v.poiBindTangent;
    #endif
    return o;
}

[maxvertexcount(9)]
void poiTripleOutlineGeom(triangle PoiTripleOutlineInput input[3], inout TriangleStream<VertexOut> outStream)
{
    UNITY_SETUP_INSTANCE_ID(input[0]);
    if (_EnableOutlines < 0.5 || _EnableOutlinesRenderFeature > 0.5)
        return;

    [unroll]
    for (int layer = 2; layer >= 0; --layer)
    {
        [unroll]
        for (int corner = 0; corner < 3; ++corner)
        {
            appdata v;
            PoiInitStruct(appdata, v);
            UNITY_TRANSFER_INSTANCE_ID(input[corner], v);
            v.vertex = input[corner].vertex;
            v.normal = input[corner].normal;
            v.tangent = input[corner].tangent;
            v.color = input[corner].color;
            v.uv0 = input[corner].uv0;
            v.uv1 = input[corner].uv1;
            v.uv2 = input[corner].uv2;
            v.uv3 = input[corner].uv3;
            v.vertexId = input[corner].vertexId;
            #ifdef POI_RAYMARCHING_DATA
            v.poiBindPosition = input[corner].poiBindPosition;
            v.poiBindNormal = input[corner].poiBindNormal;
            v.poiBindTangent = input[corner].poiBindTangent;
            #endif
            VertexOut o = vert(v, (uint)layer);
            o.poiOutlineLayer = (uint)layer;
            outStream.Append(o);
        }
        outStream.RestartStrip();
    }
}

